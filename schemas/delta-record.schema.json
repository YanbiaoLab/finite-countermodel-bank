{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YanbiaoLab/finite-countermodel-bank/schemas/delta-record.schema.json",
  "title": "Ordered table-membership delta record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage_id",
    "sequence",
    "action",
    "table_id",
    "reason_code",
    "evidence_paths"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "stage_id": { "type": "string", "pattern": "^[0-9]{2,3}-[a-z0-9-]+$" },
    "sequence": { "type": "integer", "minimum": 0 },
    "action": {
      "enum": ["add", "duplicate", "retain", "remove", "replace", "derive"]
    },
    "table_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_stage_id": { "type": "string", "pattern": "^[0-9]{2,3}-[a-z0-9-]+$" },
    "source_table_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reason_code": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" }
  }
}
