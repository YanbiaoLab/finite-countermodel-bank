{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YanbiaoLab/finite-countermodel-bank/schemas/stage-manifest.schema.json",
  "title": "Finite Countermodel Bank stage manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "stage_id",
    "title",
    "pipeline_order",
    "status",
    "captured_at",
    "depends_on",
    "claims",
    "sources",
    "artifacts",
    "verification"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "stage_id": { "type": "string", "pattern": "^[0-9]{2,3}-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "pipeline_order": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["captured", "reproduced", "verified", "blocked"] },
    "captured_at": { "type": "string", "format": "date-time" },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]{2,3}-[a-z0-9-]+$" },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checksum_file", "command"],
      "properties": {
        "checksum_file": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "locator", "captured_at", "license_status"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "kind": {
          "enum": [
            "authenticated-web-download",
            "local-filesystem-snapshot",
            "repository-snapshot",
            "generated",
            "third-party"
          ]
        },
        "locator": { "type": "string", "minLength": 1 },
        "revision": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" },
        "license_status": { "type": "string", "minLength": 1 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "media_type", "bytes", "sha256", "source_ids"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "media_type": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "record_count": { "type": "integer", "minimum": 0 },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "uniqueItems": true
        },
        "attributes": { "type": "object" }
      }
    }
  }
}
