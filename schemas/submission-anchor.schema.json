{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YanbiaoLab/finite-countermodel-bank/schemas/submission-anchor.schema.json",
  "title": "SAIR submission anchor record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "competition",
    "track",
    "model",
    "submitted_at_display",
    "display_timezone_context",
    "source_url",
    "captured_at",
    "reported_size_bytes",
    "artifact"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "submission_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "competition": { "type": "string", "minLength": 1 },
    "track": { "enum": ["solo", "marathon"] },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "submitted_at_display": { "type": "string", "minLength": 1 },
    "display_timezone_context": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "captured_at": { "type": "string", "format": "date-time" },
    "reported_size_bytes": { "type": "integer", "minimum": 0 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
