{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YanbiaoLab/finite-countermodel-bank/schemas/table-record.schema.json",
  "title": "Canonical finite operation table record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "table_id",
    "encoding",
    "order",
    "entries",
    "first_seen_stage",
    "record_kind",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "table_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "encoding": { "const": "uint8-order-row-major-v1" },
    "order": { "type": "integer", "minimum": 1, "maximum": 255 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65025,
      "items": { "type": "integer", "minimum": 0, "maximum": 254 }
    },
    "first_seen_stage": { "type": "string", "pattern": "^[0-9]{2,3}-[a-z0-9-]+$" },
    "record_kind": {
      "enum": ["exact-explicit", "derived-transpose", "verified-substitute"]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_path"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "source_path": { "type": "string", "minLength": 1 },
          "source_record": { "type": ["string", "integer"] },
          "notes": { "type": "string" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape_checked": { "type": "boolean" },
        "entry_range_checked": { "type": "boolean" },
        "task_check_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
